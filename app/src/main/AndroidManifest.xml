<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 内核：消息层 TLS 连接 + BitTorrent 监听/下载 + 局域网发现。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- mDNS（_huchuan._tcp）走组播：Android 上必须拿 WifiManager.MulticastLock 才收得到，
         拿锁要 CHANGE_WIFI_MULTICAST_STATE，读 Wi-Fi 状态要 ACCESS_WIFI_STATE。 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Android 17（API 37）本地网络保护：targetSdk >= 37 起，mDNS 组播、局域网 TCP/UDP
         都要运行时权限 android.permission.ACCESS_LOCAL_NETWORK，未授权时流量被拦住，
         表现是「找不到群」而不是报错。
         权限名取自 platforms/android-37.0/android.jar 的 android.Manifest.permission
         （data/api-versions.xml 记 since="37.0"）；OPPO（API 37）pm list permissions -g -d -f
         报 protectionLevel:dangerous，即标准运行时权限，必须现场请求。
         API < 37 的系统不认识这条声明，直接忽略；应用侧也只在 API >= 37 请求
         （见 kernel/LocalNetworkPermission.kt）。 -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- 通知三档（P7）：Android 13（API 33）起因从未发过通知的应用发系统通知要先拿
         POST_NOTIFICATIONS 运行时权限。拒绝只影响系统通知，应用内未读照常
         （未读由内核按读游标现算，见 kernel/M1Runtime + notify/NotifyPermission.kt）。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".HuchuanApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Huchuan">

        <!-- adjustResize + 页面里的 imePadding()：窗口不再走 adjustPan 整体上推。
             不写这一行时系统按 adjustUnspecified 选了 adjustPan，P4 键盘态会把标题栏
             顶进状态栏 / 挖孔区（走查见 docs/reports/oppo-layout.md 问题 2）。 -->
        <!-- launchMode=singleTop：点通知时 Activity 若已活着只走 onNewIntent（不再重建 Compose），
             由 notify/NotifyRoute 把目标页面交给 HuchuanApp 的 LaunchedEffect 消费。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Huchuan"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 系统分享入口（link-share §2.1）。只声明 SEND / SEND_MULTIPLE：不声明 VIEW（§2.2），
                 也不申请任何存储权限 —— 发送方带 FLAG_GRANT_READ_URI_PERMISSION，我们只需要
                 contentResolver.openInputStream（§2.4）。
                 mimeType="*/*" 让人能分享任意类型；text/plain 显式写出来是因为分享面板按精确类型
                 过滤时更稳。两种 action 各一套，缺一个就收不到。
                 挂在 MainActivity 而不是另起一个透明空壳：真机实测（Mi MIX 2S / API 33）App 进程
                 还活着时系统把 SEND 直接递给栈顶实例，新 Activity 根本不会被创建，分享会静默丢失
                 （证据与取舍见 docs/action-send.md）。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
    </application>

</manifest>
