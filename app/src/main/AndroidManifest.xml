<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 内核：消息层 TLS 连接 + BitTorrent 监听/下载 + 局域网发现。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- mDNS（_huchuan._tcp）走组播：Android 上必须拿 WifiManager.MulticastLock 才收得到，
         拿锁要 CHANGE_WIFI_MULTICAST_STATE，读 Wi-Fi 状态要 ACCESS_WIFI_STATE。 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Android 17（API 37）本地网络保护：targetSdk >= 37 起，mDNS 组播、局域网 TCP/UDP
         都要运行时权限 android.permission.ACCESS_LOCAL_NETWORK，未授权时流量被拦住，
         表现是「找不到群」而不是报错。
         权限名取自 platforms/android-37.0/android.jar 的 android.Manifest.permission
         （data/api-versions.xml 记 since="37.0"）；OPPO（API 37）pm list permissions -g -d -f
         报 protectionLevel:dangerous，即标准运行时权限，必须现场请求。
         API < 37 的系统不认识这条声明，直接忽略；应用侧也只在 API >= 37 请求
         （见 kernel/LocalNetworkPermission.kt）。 -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <application
        android:name=".HuchuanApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Huchuan">

        <!-- adjustResize + 页面里的 imePadding()：窗口不再走 adjustPan 整体上推。
             不写这一行时系统按 adjustUnspecified 选了 adjustPan，P4 键盘态会把标题栏
             顶进状态栏 / 挖孔区（走查见 docs/reports/oppo-layout.md 问题 2）。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Huchuan"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
