{
  "note": "逐页截图任务表。page 必须等于 document.body.dataset.page；expect 必须出现在截图那一刻的 DOM 探针（壳日志里的 DOM 探针(shot)）里。route 决定落到哪一页，page 决定壳等到哪一页再截（--shot-page）；两者不一致就是任务表写错了。数据来自取证 daemon（scripts/build-windows.sh 先起一个带「老板的群」+ 一个文件的 daemon），涉及数据的断言写的就是那份料的字面。shotDelayMs 是导航完成后最少等多久再截（默认 2200），shotTimeoutMs 是等 page 的上限（默认 15000）。probe 只给 GDI 兜底那条路用，不是门禁。",
  "jobs": [
    {
      "name": "cold-start",
      "route": null,
      "theme": "light",
      "probe": "late",
      "page": "p1",
      "expect": "最多 20 字",
      "shotDelayMs": 1200,
      "shotTimeoutMs": 20000,
      "describe": "冷启动：不带任何参数，自检放行后自动落在 P1（零点击）"
    },
    {
      "name": "p0-boot",
      "route": "p0",
      "hold": "boot",
      "page": "p0",
      "expect": "正在启动",
      "describe": "P0 自检 · 启动中",
      "theme": "light"
    },
    {
      "name": "p0-check",
      "route": "p0",
      "hold": "checking",
      "page": "p0",
      "expect": "正在检测网络",
      "describe": "P0 自检 · 检测中",
      "theme": "light"
    },
    {
      "name": "p0-pass",
      "route": "p0",
      "hold": "result",
      "page": "p0",
      "expect": "可互传",
      "shotDelayMs": 2600,
      "describe": "P0 自检 · 成功后（自动放行前）",
      "theme": "light"
    },
    {
      "name": "p0-degraded",
      "route": "p0",
      "hold": "result",
      "network": "limited",
      "page": "p0",
      "expect": "仅局域网可用",
      "describe": "P0 自检 · 降级（仅局域网可用）",
      "theme": "light"
    },
    {
      "name": "p0-failed",
      "route": "p0",
      "hold": "result",
      "network": "fail",
      "page": "p0",
      "expect": "网络不可用",
      "describe": "P0 自检 · 失败（只有重试）",
      "theme": "light"
    },
    {
      "name": "p1-username",
      "route": "p1",
      "page": "p1",
      "expect": "最多 20 字",
      "describe": "P1 用户名",
      "theme": "light"
    },
    {
      "name": "p2-home",
      "route": "p2",
      "page": "p2",
      "expect": "老板的群",
      "describe": "P2 首页",
      "theme": "light"
    },
    {
      "name": "p3-group",
      "route": "p3",
      "page": "p3",
      "expect": "添加文件",
      "describe": "P3 群组",
      "theme": "light"
    },
    {
      "name": "p4-file",
      "route": "p4",
      "page": "p4",
      "expect": "单文件限速",
      "describe": "P4 文件详情",
      "theme": "light"
    },
    {
      "name": "p5-new-group",
      "route": "p5",
      "page": "p5",
      "expect": "新建群组",
      "describe": "P5 新群组",
      "theme": "light"
    },
    {
      "name": "p6-members",
      "route": "p6",
      "page": "p6",
      "expect": "邀请码",
      "describe": "P6 成员",
      "theme": "light"
    },
    {
      "name": "p7-settings",
      "route": "p7",
      "page": "p7",
      "expect": "全局限速",
      "describe": "P7 设置抽屉",
      "theme": "light"
    },
    {
      "name": "p2-home-dark",
      "route": "p2",
      "theme": "dark",
      "page": "p2",
      "expect": "老板的群",
      "describe": "P2 首页 · 深色"
    },
    {
      "name": "p4-file-dark",
      "route": "p4",
      "theme": "dark",
      "page": "p4",
      "expect": "单文件限速",
      "describe": "P4 文件详情 · 深色"
    },
    {
      "name": "p7-settings-dark",
      "route": "p7",
      "theme": "dark",
      "page": "p7",
      "expect": "全局限速",
      "describe": "P7 设置抽屉 · 深色"
    }
  ]
}
