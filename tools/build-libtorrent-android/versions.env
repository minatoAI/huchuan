# Pinned inputs for the Android arm64 libtorrent4j build.
# Everything the build downloads is referenced from here; bump these and the
# artifacts (and their sha256 values) are expected to change.

NDK_VERSION=28.2.13676358
ANDROID_ABI=arm64-v8a
ANDROID_API=28

# libtorrent4j: Java API + SWIG/JNI surface. The tag also pins the libtorrent
# submodule commit that the checked-in libtorrent_jni.cpp was generated from.
LIBTORRENT4J_URL=https://github.com/aldenml/libtorrent4j.git
LIBTORRENT4J_TAG=v2.1.0-39
LIBTORRENT4J_VERSION=2.1.0-39

# libtorrent itself: RC_2_1 head 170663b (2026-10-28). The official artifact
# pins 24a3adf, which aborts with "Scudo ERROR: invalid chunk state" on
# Android 13 because it predates the disk I/O lifetime fixes.
LIBTORRENT_SHA=170663b4b4fad545a6e40e77d03a9f66c8d7c363

BOOST_VERSION=1.90.0
BOOST_URL=https://archives.boost.io/release/1.90.0/source/boost_1_90_0.tar.gz

# OpenSSL is built as a static library for arm64-v8a; the options mirror
# libtorrent4j's own CI (.github/workflows/android.yml).
OPENSSL_VERSION=3.5.5
OPENSSL_URL=https://codeload.github.com/openssl/openssl/tar.gz/refs/tags/openssl-3.5.5
OPENSSL_OPTS="no-deprecated no-shared no-makedepend no-static-engine no-stdio no-posix-io no-threads no-ui-console no-zlib no-zlib-dynamic -fno-strict-aliasing -fvisibility=hidden -O3"

# Windows/MSYS hosts only: Git for Windows ships no GNU make, so one is fetched
# from msys2 and unpacked into the scratch tree (Linux/macOS use the system make).
MAKE_PKG=make-4.4.1-2-x86_64.pkg.tar.zst
MAKE_PKG_URL=https://mirrors.tuna.tsinghua.edu.cn/msys2/msys/x86_64/make-4.4.1-2-x86_64.pkg.tar.zst

# OpenSSL bakes "built on: <date>" into libcrypto unless SOURCE_DATE_EPOCH is set,
# which makes the .so hash depend on when the build ran. Pin it.
SOURCE_DATE_EPOCH_VALUE=1735689600   # 2025-01-01T00:00:00Z

DL_RETRIES=8
GIT_RETRIES=20
